      <button class="tab active" data-filter="all" role="tab" aria-selected="true">All Work</button>
      <button class="tab" data-filter="creative" role="tab" aria-selected="false">Creative</button>
      <button class="tab" data-filter="copy" role="tab" aria-selected="false">Website Copy</button>
      <button class="tab" data-filter="blog" role="tab" aria-selected="false">Blog Writing</button>
    </div>
  </div>

  <div class="wrap">

    <div class="case reveal" data-category="creative">
      <div class="case-info">
        <div class="meta">Creative &middot; 2020</div>
        <h3>Golden Road Productions</h3>
        <p>Screenwriting and creative consulting on the short film <em>Joseph and Evade</em> (2022), bringing a literature and film background to bear outside of commercial copy.</p>
