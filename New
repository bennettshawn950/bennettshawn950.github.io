      <div class="num">60+</div>
      <div class="label">Optician websites rewritten for Hakim Group</div>
    </div>
    <div class="stat reveal">
      <div class="num">60+</div>
      <div class="label">Blog posts, features &amp; newsletters for House of Staunton / USCF</div>
    </div>
    <div class="stat reveal">
      <div class="num">3+ yrs</div>
