    </div>
  </div>
</section>

<div class="marquee">
  <div class="track">
    <span>Creative</span><span>Website Copy</span><span>Blog Writing</span><span>Creative</span>
    <span>Website Copy</span><span>Blog Writing</span><span>Creative</span><span>Website Copy</span>
  </div>
</div>

<section id="work">
  <div class="wrap">
    <div class="eyebrow reveal">Selected Work</div>
