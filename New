<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Shawn Bennett — Copywriter</title>
<meta name="description" content="Shawn Bennett is a freelance copywriter specialising in web copy, long-form articles, newsletters and screenwriting.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Work+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F5F3EE;
    --paper-alt:#ECE7DA;
    --ink:#1C1B19;
    --ink-soft:#57534A;
    --ribbon:#8B2E2E;
    --ribbon-dark:#6E2323;
    --line:#D9D2C0;
    --max:1080px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Work Sans', sans-serif;
    font-size:17px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }

  a{color:inherit;}

  .wrap{
    max-width:var(--max);
    margin:0 auto;
    padding:0 32px;
  }

  /* ---------- utility / eyebrow ---------- */
  .eyebrow{
    font-family:'Space Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--ribbon);
    display:flex;
    align-items:center;
    gap:10px;
  }
  .eyebrow::before{
    content:"";
    width:22px;
    height:1px;
    background:var(--ribbon);
    display:inline-block;
  }

  /* ---------- nav ---------- */
  header.site{
    position:sticky;
    top:0;
    z-index:50;
    background:rgba(245,243,238,0.86);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    max-width:var(--max);
    margin:0 auto;
    padding:18px 32px;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .nav .name{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:19px;
    text-decoration:none;
    letter-spacing:0.01em;
  }
  .nav .links{
    display:flex;
    gap:28px;
    font-family:'Space Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.06em;
    text-transform:uppercase;
  }
  .nav .links a{
    text-decoration:none;
    color:var(--ink-soft);
    transition:color .15s ease;
    padding-bottom:2px;
    border-bottom:1px solid transparent;
  }
  .nav .links a:hover, .nav .links a:focus-visible{
    color:var(--ink);
    border-bottom-color:var(--ribbon);
  }

  /* ---------- hero ---------- */
  .hero{
    padding:110px 0 90px;
    position:relative;
  }
  .hero .eyebrow{margin-bottom:26px;}
  h1.display{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(48px, 8vw, 92px);
    line-height:1.02;
    margin:0 0 10px;
    letter-spacing:-0.01em;
  }
  .hero .role{
    font-family:'Fraunces', serif;
    font-style:italic;
    font-weight:500;
    font-size:clamp(20px, 2.6vw, 28px);
    color:var(--ribbon-dark);
    margin:0 0 34px;
  }
  .hero .tagline{
    max-width:560px;
    font-size:18px;
    color:var(--ink-soft);
    margin:0 0 40px;
  }
  .underline-mark{
    position:relative;
    display:inline-block;
  }
  .underline-mark svg{
    position:absolute;
    left:0; bottom:-9px;
    width:100%;
    height:10px;
  }

  .btn{
    display:inline-flex;
    align-items:center;
    gap:10px;
    font-family:'Space Mono', monospace;
    font-size:13px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    text-decoration:none;
    color:var(--paper);
    background:var(--ink);
    padding:14px 22px;
    border:1px solid var(--ink);
    transition:background .18s ease, color .18s ease;
  }
  .btn:hover, .btn:focus-visible{
    background:var(--ribbon);
    border-color:var(--ribbon);
  }
  .btn.ghost{
    background:transparent;
    color:var(--ink);
  }
  .btn.ghost:hover{
    background:var(--ink);
    color:var(--paper);
  }

  /* ---------- stats strip ---------- */
  .stats{
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    background:var(--paper-alt);
  }
  .stats .wrap{
    padding:46px 32px;
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:36px;
  }
  .stat .num{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(34px, 4vw, 46px);
    color:var(--ribbon);
    line-height:1;
  }
  .stat .label{
    margin-top:10px;
    font-size:14.5px;
    color:var(--ink-soft);
    max-width:220px;
  }

  /* ---------- section shell ---------- */
  section{padding:96px 0;}
  section.tight{padding:70px 0;}
  h2.section-title{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(30px, 4vw, 42px);
    margin:16px 0 0;
    max-width:640px;
    line-height:1.12;
  }

  /* ---------- about ---------- */
  .about-grid{
    display:grid;
    grid-template-columns:1.1fr 1fr;
    gap:64px;
    align-items:start;
    margin-top:36px;
  }
  .about-grid p{
    color:var(--ink-soft);
    font-size:16.5px;
    margin:0 0 20px;
  }
  .about-grid p:last-child{margin-bottom:0;}
  .pull{
    font-family:'Fraunces', serif;
    font-style:italic;
    font-weight:500;
    font-size:22px;
    color:var(--ink);
    border-left:2px solid var(--ribbon);
    padding-left:22px;
    line-height:1.4;
  }

  /* ---------- marquee divider ---------- */
  .marquee{
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    padding:14px 0;
    overflow:hidden;
    white-space:nowrap;
    background:var(--paper);
  }
  .marquee .track{
    display:inline-block;
    font-family:'Space Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--ink-soft);
    animation:scroll 26s linear infinite;
  }
  .marquee span{margin:0 22px;}
  .marquee span::after{content:"—"; margin-left:22px; color:var(--ribbon);}
  @keyframes scroll{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }

  /* ---------- work ---------- */
  .work-intro{margin-top:36px; max-width:600px; color:var(--ink-soft); font-size:16.5px;}

  .tabs{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top:34px;
  }
  .tab{
    font-family:'Space Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    background:transparent;
    color:var(--ink-soft);
    border:1px solid var(--line);
    padding:10px 18px;
    cursor:pointer;
    transition:background .15s ease, color .15s ease, border-color .15s ease;
  }
  .tab:hover{border-color:var(--ribbon);}
  .tab.active{
    background:var(--ink);
    color:var(--paper);
    border-color:var(--ink);
  }
  .case.hidden{display:none;}

  .case{
    padding:64px 0;
    border-top:1px solid var(--line);
    display:grid;
    grid-template-columns:0.9fr 1.1fr;
    gap:56px;
    align-items:start;
  }
  .case:last-child{border-bottom:1px solid var(--line);}
  .case-info .meta{
    font-family:'Space Mono', monospace;
    font-size:12px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--ribbon);
    margin-bottom:14px;
  }
  .case-info h3{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:30px;
    margin:0 0 16px;
    line-height:1.1;
  }
  .case-info p{
    color:var(--ink-soft);
    font-size:15.5px;
    margin:0 0 18px;
    max-width:420px;
  }
  .case-info .live{
    font-family:'Space Mono', monospace;
    font-size:12.5px;
    letter-spacing:0.05em;
    text-decoration:none;
    color:var(--ink);
    border-bottom:1px solid var(--ribbon);
    padding-bottom:2px;
  }
  .case-images{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
  }
  .shot{
    border:1px solid var(--line);
    background:var(--paper-alt);
    overflow:hidden;
  }
  .shot img{
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:top;
    display:block;
  }
  .shot.full{grid-column:1 / -1;}
  .shot.full img{object-fit:contain; background:var(--paper);}

  /* ---------- contact ---------- */
  .contact{
    background:var(--ink);
    color:var(--paper);
  }
  .contact .eyebrow{color:#C98080;}
  .contact .eyebrow::before{background:#C98080;}
  .contact h2.section-title{color:var(--paper);}
  .contact-row{
    margin-top:40px;
    display:flex;
    flex-wrap:wrap;
    gap:40px;
    align-items:baseline;
  }
  .contact-item .k{
    font-family:'Space Mono', monospace;
    font-size:11.5px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:#9A968C;
    margin-bottom:8px;
  }
  .contact-item a{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:22px;
    text-decoration:none;
    color:var(--paper);
    border-bottom:1px solid transparent;
  }
  .contact-item a:hover, .contact-item a:focus-visible{
    border-bottom-color:var(--ribbon);
  }

  footer{
    background:var(--ink);
    color:#8B877D;
    font-family:'Space Mono', monospace;
    font-size:12px;
    padding:26px 0 40px;
  }

  /* ---------- reveal ---------- */
  .reveal{
    opacity:0;
    transform:translateY(14px);
    transition:opacity .6s ease, transform .6s ease;
  }
  .reveal.in{opacity:1; transform:translateY(0);}

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    .reveal{opacity:1; transform:none; transition:none;}
    .marquee .track{animation:none;}
  }

  /* ---------- responsive ---------- */
  @media (max-width: 860px){
    .about-grid{grid-template-columns:1fr; gap:28px;}
    .stats .wrap{grid-template-columns:1fr; gap:26px; padding:38px 24px;}
    .case{grid-template-columns:1fr; gap:26px; padding:48px 0;}
    .case-images{grid-template-columns:1fr;}
    .nav .links{gap:16px;}
    section{padding:64px 0;}
    .hero{padding:80px 0 60px;}
  }
  @media (max-width: 520px){
    .nav .links a:nth-child(3){display:none;}
    .wrap{padding:0 20px;}
  }
</style>
</head>
<body>

<header class="site">
  <div class="nav">
    <a class="name" href="#top">Shawn Bennett</a>
    <div class="links">
      <a href="#about">About</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>
    </div>
  </div>
</header>

<div id="top"></div>

<section class="hero">
  <div class="wrap">
    <div class="eyebrow reveal">Freelance Copywriter</div>
    <h1 class="display reveal">Shawn Bennett</h1>
